rules_version = '2';
// GariDoctor cloud backup: each signed-in user can read/write only their own backup document.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid
                         && (request.resource == null || request.resource.data.backup.size() < 900000);
    }
  }
}
