  {
   "id": "tyre_tread",
   "title": {
    "en": "Tyre tread check",
    "bn": "টায়ারের গ্রিপ (ট্রেড) চেক"
   },
   "steps": [
    {
     "en": "Park on flat ground and look at the centre of the tyre.",
     "bn": "সমান জায়গায় পার্ক করে টায়ারের মাঝখানটা দেখুন।"
    },
    {
     "en": "Find the small raised bar (wear indicator) inside the grooves.",
     "bn": "খাঁজের ভেতরে ছোট উঁচু দাগ (ওয়্যার ইন্ডিকেটর) খুঁজুন।"
    },
    {
     "en": "Insert a 1-taka coin edge into the groove and compare.",
     "bn": "১ টাকার কয়েনের কিনারা খাঁজে ঢুকিয়ে তুলনা করুন।"
    }
   ],
   "references": [
    {
     "label": {
      "en": "Deep grooves",
      "bn": "গভীর খাঁজ"
     },
     "description": {
      "en": "Grooves clearly deeper than the wear bar (>2 mm).",
      "bn": "খাঁজ ওয়্যার দাগের চেয়ে স্পষ্ট গভীর (>২ মিমি)।"
     },
     "passes": true,
