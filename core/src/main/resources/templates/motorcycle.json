 "checks": [
  {
   "id": "tyre_tread",
   "title": {
    "en": "Tyre tread check",
    "bn": "টায়ারের গ্রিপ (ট্রেড) চেক"
   },
   "steps": [
    {
     "en": "Park on flat ground and look at the centre of the tyre.",
     "bn": "সমান জায়গায় পার্ক করে টায়ারের মাঝখানটা দেখুন।"
    },
    {
     "en": "Find the small raised bar (wear indicator) inside the grooves.",
     "bn": "খাঁজের ভেতরে ছোট উঁচু দাগ (ওয়্যার ইন্ডিকেটর) খুঁজুন।"
    },
    {
     "en": "Insert a 1-taka coin edge into the groove and compare.",
     "bn": "১ টাকার কয়েনের কিনারা খাঁজে ঢুকিয়ে তুলনা করুন।"
    }
   ],
   "references": [
    {
     "label": {
      "en": "Deep grooves",
      "bn": "গভীর খাঁজ"
     },
     "description": {
      "en": "Grooves clearly deeper than the wear bar (>2 mm).",
      "bn": "খাঁজ ওয়্যার দাগের চেয়ে স্পষ্ট গভীর (>২ মিমি)।"
     },
     "passes": true,
     "image": "tyre_good"
    },
    {
     "label": {
      "en": "Level with wear bar",
      "bn": "ওয়্যার দাগের সমান"
     },
     "description": {
      "en": "Tread is flush with the indicator: replace soon.",
      "bn": "ট্রেড ইন্ডিকেটরের সমান: শীঘ্রই বদলান।"
     },
     "passes": false,
     "image": "tyre_worn"
    },
    {
     "label": {
      "en": "Bald / cracked / bulge",
      "bn": "মসৃণ / ফাটা / ফোলা"
     },
     "description": {
      "en": "No grooves, cracks in sidewall or a bulge: unsafe.",
      "bn": "খাঁজ নেই, পাশে ফাটল বা ফোলা: বিপজ্জনক।"
     },
     "passes": false,
     "image": "tyre_bald"
    }
   ]
  },
  {
   "id": "chain_slack",
   "title": {
    "en": "Chain slack check",
    "bn": "চেইন ঢিলা চেক"
   },
   "steps": [
    {
     "en": "Put the bike on the main stand, gear in neutral.",
     "bn": "বাইক মেইন স্ট্যান্ডে রাখুন, গিয়ার নিউট্রালে।"
    },
    {
     "en": "Push the chain up and down at the middle of the lower run.",
     "bn": "নিচের অংশের মাঝখানে চেইন উপরে-নিচে চাপ দিন।"
    },
    {
     "en": "Measure total up-down movement.",
     "bn": "মোট কতটুকু ওঠানামা করে মাপুন।"
    }
   ],
   "references": [
    {
     "label": {
      "en": "20–30 mm movement",
      "bn": "২০–৩০ মিমি নড়ে"
     },
     "description": {
      "en": "Correct slack, chain looks oiled.",
      "bn": "ঠিক আছে, চেইনে তেল আছে।"
     },
     "passes": true,
     "image": "chain_good"
    },
    {
     "label": {
      "en": "More than 40 mm / sagging",
      "bn": "৪০ মিমির বেশি / ঝুলে আছে"
     },
     "description": {
      "en": "Too loose: adjust now. Can jump the sprocket.",
      "bn": "বেশি ঢিলা: এখনই টাইট দিন। স্প্রোকেট থেকে পড়ে যেতে পারে।"
     },
     "passes": false,
     "image": "chain_loose"
    },
    {
     "label": {
      "en": "Tight, rusty or kinked links",
      "bn": "টাইট, মরিচা বা বাঁকা লিংক"
     },
     "description": {
      "en": "Clean, lubricate, or replace chain set.",
      "bn": "পরিষ্কার করে তেল দিন বা চেইন সেট বদলান।"
     },
     "passes": false,
     "image": "chain_rusty"
    }
   ]
  },
  {
   "id": "brake_pad",
   "title": {
    "en": "Brake pad thickness",
    "bn": "ব্রেক প্যাডের পুরুত্ব"
   },
   "steps": [
    {
     "en": "Look through the caliper gap with a phone torch.",
     "bn": "ফোনের টর্চ দিয়ে ক্যালিপারের ফাঁক দিয়ে দেখুন।"
    },
    {
     "en": "Find the pad material between the metal plate and the disc.",
     "bn": "ধাতব প্লেট আর ডিস্কের মাঝে প্যাডের অংশ দেখুন।"
    },
    {
     "en": "For drum brakes: check the wear-indicator arrow on the hub.",
     "bn": "ড্রাম ব্রেকে: হাবের ওয়্যার ইন্ডিকেটর তীর দেখুন।"
    }
   ],
   "references": [
    {
     "label": {
      "en": "3 mm or more",
      "bn": "৩ মিমি বা বেশি"
     },
     "description": {
      "en": "Plenty of pad left.",
      "bn": "যথেষ্ট প্যাড আছে।"
     },
     "passes": true,
     "image": "pad_good"
    },
    {
     "label": {
      "en": "Less than 2 mm",
      "bn": "২ মিমির কম"
     },
     "description": {
      "en": "Replace pads this week.",
      "bn": "এই সপ্তাহে প্যাড বদলান।"
     },
     "passes": false,
     "image": "pad_thin"
    },
    {
     "label": {
      "en": "Metal on metal / grinding",
      "bn": "ধাতুতে ধাতু ঘষা / কিচকিচ শব্দ"
     },
     "description": {
      "en": "Stop riding: disc is being damaged.",
      "bn": "চালানো বন্ধ করুন: ডিস্ক নষ্ট হচ্ছে।"
     },
     "passes": false,
     "image": "pad_gone"
    }
   ]
  },
  {
   "id": "oil_level",
   "title": {
    "en": "Engine oil level",
    "bn": "ইঞ্জিন অয়েলের লেভেল"
   },
   "steps": [
    {
     "en": "Engine off for 5 minutes, vehicle upright on level ground.",
     "bn": "ইঞ্জিন ৫ মিনিট বন্ধ রাখুন, সমান জায়গায় সোজা রাখুন।"
    },
    {
     "en": "Pull the dipstick (or look in the sight glass), wipe, re-insert, check.",
     "bn": "ডিপস্টিক তুলে মুছে আবার ঢুকিয়ে দেখুন (বা সাইট গ্লাস দেখুন)।"
    }
   ],
   "references": [
    {
     "label": {
      "en": "Between MIN and MAX, amber/brown",
      "bn": "MIN ও MAX এর মাঝে, হালকা বাদামি"
     },
     "description": {
      "en": "Level and colour OK.",
      "bn": "লেভেল ও রং ঠিক আছে।"
     },
     "passes": true,
     "image": "oil_good"
    },
    {
     "label": {
      "en": "Below MIN",
      "bn": "MIN এর নিচে"
     },
     "description": {
      "en": "Top up today; check for leaks.",
      "bn": "আজই তেল দিন; লিক আছে কিনা দেখুন।"
     },
     "passes": false,
     "image": "oil_low"
    },
    {
     "label": {
      "en": "Black & thick or milky",
      "bn": "কালো ঘন বা দুধের মতো"
     },
     "description": {
      "en": "Change oil. Milky oil can mean coolant leak.",
      "bn": "তেল বদলান। দুধের মতো হলে কুল্যান্ট লিক হতে পারে।"
     },
     "passes": false,
     "image": "oil_dirty"
    }
   ]
  },
  {
   "id": "battery_terminal",
   "title": {
    "en": "Battery terminals",
    "bn": "ব্যাটারি টার্মিনাল"
   },
   "steps": [
    {
     "en": "Engine off. Look at both battery terminals.",
     "bn": "ইঞ্জিন বন্ধ। ব্যাটারির দুই টার্মিনাল দেখুন।"
    },
    {
     "en": "Try to wiggle each cable clamp by hand.",
     "bn": "হাত দিয়ে প্রতিটি ক্লাম্প নাড়িয়ে দেখুন।"
    }
   ],
   "references": [
    {
     "label": {
      "en": "Clean and tight",
      "bn": "পরিষ্কার ও টাইট"
     },
     "description": {
      "en": "No corrosion, clamps don't move.",
      "bn": "মরিচা নেই, ক্লাম্প নড়ে না।"
     },
     "passes": true,
     "image": "batt_good"
    },
    {
     "label": {
      "en": "White/green powder",
      "bn": "সাদা/সবুজ গুঁড়া"
     },
     "description": {
      "en": "Corrosion: clean with baking soda water.",
      "bn": "মরিচা: খাবার সোডা পানি দিয়ে পরিষ্কার করুন।"
     },
     "passes": false,
     "image": "batt_corroded"
    },
    {
     "label": {
      "en": "Loose clamp",
      "bn": "ক্লাম্প ঢিলা"
     },
     "description": {
      "en": "Tighten; loose terminals cause slow start.",
      "bn": "টাইট দিন; ঢিলা টার্মিনালে স্টার্ট দেরিতে হয়।"
     },
     "passes": false,
     "image": "batt_loose"
    }
   ]
  }
 ],
